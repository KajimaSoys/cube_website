# syntax=docker/dockerfile:1

# Стадия 1: сборка Vue
FROM node:26.13.1-alpine3.24 AS build
WORKDIR /app
COPY client/package.json client/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY client/ .
RUN npm run build

# Стадия 2: nginx от непривилегированного пользователя (uid 101), слушает 8080
FROM nginx/nginx-unprivileged:1.31.9-alpine
# Обновления безопасности Alpine, затем обратно на непривилегированного пользователя nginx (101).
USER root
RUN apk upgrade --no-cache
USER 101
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
